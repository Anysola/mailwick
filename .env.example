# ---- Required ----

# Encrypts session data (the mail password is stored encrypted while you're signed in).
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Your mail server. 993 = IMAPS (implicit TLS), 143 = STARTTLS.
IMAP_HOST=mail.example.com
IMAP_PORT=993

# ---- Optional ----

# SMTP server for sending; defaults to IMAP_HOST. 465 = implicit TLS, 587 = STARTTLS.
# SMTP_HOST=mail.example.com
SMTP_PORT=465

# Only allow these domains to sign in (comma separated). Empty = any address your server accepts.
# With exactly one domain, people can sign in with just the part before the @.
ALLOWED_DOMAINS=

# Branding
APP_NAME=Mailwick
# LOGO_URL=https://example.com/logo.svg

# Interface language when the browser's language isn't supported (en, de, fr, tr, ja, …)
DEFAULT_LOCALE=en

# Redis (docker-compose sets this for you)
REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_PREFIX=mailwick:

# Set to 1 behind a reverse proxy (nginx, Caddy, Traefik, Cloudflare) so login
# rate limiting sees the real client IP instead of the proxy's.
TRUST_PROXY=0

# Force IMAP/SMTP TLS mode instead of guessing from the port (1 = implicit TLS, 0 = STARTTLS)
# IMAP_SECURE=1
# SMTP_SECURE=1

# Accept self-signed certificates. Only for local testing!
# TLS_INSECURE=1
